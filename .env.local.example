# Sentinel Arena secrets and LLM defaults
# Fill these with your real keys before running LLM-powered modes.

OPENAI_API_KEY=sk-openai-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional provider/model defaults (for upcoming per-side LLM routing)
SENTINEL_TASK_AGENT_PROVIDER=openai
SENTINEL_TASK_AGENT_MODEL=gpt-5-mini
SENTINEL_RED_TEAM_PROVIDER=anthropic
SENTINEL_RED_TEAM_MODEL=claude-sonnet-4-6

# Optional sampling controls
SENTINEL_TASK_AGENT_TEMPERATURE=0.3
SENTINEL_RED_TEAM_TEMPERATURE=0.7
